# Google Gemini API（Nano Banana / Nano Banana Pro / Veo）
# Google Cloud の請求アカウントに紐づいたプロジェクトで作成したキー  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# fal.ai（Seedream / FLUX / Seedance / Kling / Hailuo / MMAudio など）※任意
# https://fal.ai/dashboard/keys
FAL_KEY=

# Fish Audio（ナレーション）  https://fish.audio/app/api-keys
FISH_AUDIO_API_KEY=
# Fish Audio の TTS モデル（s1 / speech-1.6 / speech-1.5）
FISH_AUDIO_MODEL=s1

# 生成物の保存先（省略時は ./storage）
# STORAGE_DIR=/path/to/storage
